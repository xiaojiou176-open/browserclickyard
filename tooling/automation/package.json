{
  "name": "ui-automation-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node -e \"const fs=require('node:fs');const dir='../../.runtime-cache/automation';fs.mkdirSync(dir,{recursive:true});fs.writeFileSync(dir+'/tsconfig.check.json',JSON.stringify({extends:'../../tsconfig.json',exclude:['../../scripts/midscene-driver.ts']},null,2));\" && bash ../../scripts/lib/node-bin.sh tsc --noEmit --project ../../.runtime-cache/automation/tsconfig.check.json",
    "lint": "bash ../../scripts/lib/node-bin.sh eslint . -f json",
    "automation:convert:curl": "bash scripts/run-curlconverter-safe.sh",
    "automation:har:k6": "bash scripts/run-har-to-k6-safe.sh",
    "tool:curlconverter": "pnpm run automation:convert:curl",
    "tool:har-to-k6": "pnpm run automation:har:k6",
    "record": "bash ../../scripts/lib/node-bin.sh tsx scripts/record-session.ts",
    "record:manual": "bash ../../scripts/lib/node-bin.sh tsx scripts/record-session.ts --mode=manual",
    "record:cdp": "bash ../../scripts/lib/node-bin.sh tsx scripts/record-via-cdp.ts",
    "extract": "bash ../../scripts/lib/node-bin.sh tsx scripts/extract-flow-spec.ts",
    "extract:register": "bash ../../scripts/lib/node-bin.sh tsx scripts/extract-register-spec.ts",
    "extract:video": "bash ../../scripts/lib/node-bin.sh tsx scripts/extract-video-flow.ts",
    "report:ui-ux:gemini": "bash ../../scripts/lib/node-bin.sh tsx scripts/generate-ui-ux-gemini-report.ts",
    "generate-case": "bash ../../scripts/lib/node-bin.sh tsx scripts/generate-playwright-case.ts",
    "generate:reconstruction": "bash ../../scripts/lib/node-bin.sh tsx scripts/generate-from-reconstruction.ts",
    "replay": "bash ../../scripts/lib/node-bin.sh tsx scripts/replay-register.ts",
    "replay-flow": "bash ../../scripts/lib/node-bin.sh tsx scripts/replay-flow-draft.ts",
    "replay-flow-step": "bash ../../scripts/lib/node-bin.sh tsx scripts/replay-flow-step.ts",
    "reconstruct-and-replay": "bash ../../scripts/lib/node-bin.sh tsx scripts/reconstruct-and-replay.ts",
    "test": "bash ../../scripts/lib/node-bin.sh playwright test",
    "test:wrapper:smoke": "bash ../../scripts/lib/node-bin.sh tsx --test tests/wrapper-safe-smoke.test.ts",
    "live:preflight:key": "UIQ_LIVE_LLM_ENABLED=true node ../../scripts/lib/live-key-preflight.mjs --assert",
    "test:live:web": "UIQ_LIVE_EXTERNAL_ENABLED=true node ../../scripts/lib/live-key-preflight.mjs --assert --skip-llm && UIQ_LIVE_EXTERNAL_ENABLED=true UIQ_LIVE_RETRIES=${UIQ_LIVE_RETRIES:-2} UIQ_LIVE_ALLOW_INSECURE_CERTS=${UIQ_LIVE_ALLOW_INSECURE_CERTS:-false} bash ../../scripts/lib/node-bin.sh playwright test -c playwright.live.config.ts tests/live-external-web.spec.ts",
    "test:live:llm": "pnpm run live:preflight:key && UIQ_LIVE_LLM_ENABLED=true bash ../../scripts/lib/node-bin.sh tsx --test tests/live-gemini-smoke.test.ts",
    "test:live:short-first": "pnpm run test:live:web && pnpm run test:live:llm"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@google/genai": "1.48.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "ajv": "^6.14.0",
    "curlconverter": "^4.12.0",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "har-to-k6": "^0.14.10",
    "playwright": "^1.59.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.27.0"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
