# Live smoke toggles (non-sensitive)
# Required for enabling real external and real LLM smoke checks.
# Key governance: runtime key resolution only accepts process.env or repo-root .env.
UIQ_LIVE_EXTERNAL_ENABLED=true
UIQ_LIVE_LLM_ENABLED=true

# External site target for live smoke.
# Default is example.com; replace with your allowed real target domain when needed.
UIQ_LIVE_EXTERNAL_URL=example.com
# Comma-separated allowlist for external live smoke target hosts.
UIQ_LIVE_EXTERNAL_ALLOWLIST=example.com

# Gemini model used by live LLM smoke.
UIQ_LIVE_LLM_MODEL=gemini-3.1-pro-preview

# Sensitive credentials (placeholders only, do not commit real values)
# Note: GEMINI_API_KEY in this file is documentation-only and not used as runtime key source.
# Required when UIQ_LIVE_LLM_ENABLED=true.
GEMINI_API_KEY=replace-with-real-gemini-key
# Backend automation auth token (required for protected automation APIs).
AUTOMATION_API_TOKEN=replace-with-strong-token
