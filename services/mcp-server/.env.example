# MCP server currently consumes repo-level environment variables only.
# This file keeps the minimum subset needed to explain package-level usage.

# Repo-native default backend lane for MCP.
UIQ_MCP_API_BASE_URL=http://127.0.0.1:18080

# Keep strict MCP defaults unless a local test case needs to relax them.
UIQ_MCP_PERFECT_MODE=true

# Enable optional MCP tool groups only when needed.
UIQ_MCP_TOOL_GROUPS=advanced,analysis,proof

# Only required when token-protected automation/API surfaces are enabled.
AUTOMATION_API_TOKEN=replace-with-strong-token
